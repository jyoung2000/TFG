# Copy to deploy/.env. The token is required: every request to the backend
# carries it (Authorization: Bearer …) and the desktop's Remote backend
# setting stores it.
LTX_AUTH_TOKEN=change-me-to-a-long-random-string
TFG_PORT=8000
OLLAMA_PORT=11434
WANGP_REF=main
WANGP_VIDEO_MODEL_TYPE=ltx2_22B_distilled
WANGP_IMAGE_MODEL_TYPE=z_image
TFG_VLM_MODEL=qwen2.5vl:3b
